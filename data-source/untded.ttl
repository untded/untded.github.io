  rdfs:comment "The printed business term (synonym).";
  rdfs:domain utd:TradeDataElement .

utd:category a <rdf:Property>;
  rdfs:comment "The tag-range category the element belongs to.";
  rdfs:domain utd:TradeDataElement .

utd:changeTag a <rdf:Property>;
  rdfs:comment "The printed change indicator against the 1993 edition.";
  rdfs:domain utd:TradeDataElement .

utd:charset a <rdf:Property>;
  rdfs:comment "The character class of the representation: a, an or n.";
  rdfs:domain utd:TradeDataElement .

utd:elementCount a <rdf:Property>;
  rdfs:comment "The number of member elements." .

utd:maxLength a <rdf:Property>;
  rdfs:comment "Maximum number of characters in a value.";
  rdfs:domain utd:TradeDataElement .

utd:minLength a <rdf:Property>;
  rdfs:comment "Minimum number of characters in a value.";
  rdfs:domain utd:TradeDataElement .

utd:oldName a <rdf:Property>;
  rdfs:comment "The data element name in the 1993 edition.";
  rdfs:domain utd:TradeDataElement .

utd:representation a <rdf:Property>;
  rdfs:comment "The printed character representation notation, e.g. an..35.";
  rdfs:domain utd:TradeDataElement .

utd:sourcePage a <rdf:Property>;
  rdfs:comment "Page of the source publication the entry appears on.";
  rdfs:domain utd:TradeDataElement .

utd:status a <rdf:Property>;
  rdfs:comment "active or retired, per the printed change indicator.";
  rdfs:domain utd:TradeDataElement .

utd:tag a <rdf:Property>;
  rdfs:comment "The four-digit unique identifier of the data element.";
  rdfs:domain utd:TradeDataElement .

utd:tagRange a <rdf:Property>;
  rdfs:comment "The tag interval of the category, e.g. 1000-1699.";
  rdfs:domain utd:Category .

