utd:Category a rdfs:Class;
  rdfs:comment "One of the nine ordered tag ranges into which the directory groups its data elements." .

utd:CategoryScheme a rdfs:Class,
    utd:CategoryScheme;
  rdfs:label "UNTDED tag-range category scheme";
  rdfs:comment "The ordered scheme of the nine tag-range categories.",
    "The nine ordered tag ranges of the Trade Data Elements Directory (TDED section 4.2)." .

utd:TradeDataElement a rdfs:Class;
  rdfs:comment "A data element of the Trade Data Elements Directory: a named, defined unit of trade information with a tag and a representation." .

<https://www.untded.org/elements/1000> a utd:TradeDataElement;
  schema:description "Free text name of a document such as 'Proforma invoice', 'Commercial invoice'.";
  schema:isPartOf <https://www.untded.org/dataset/untded-2005>;
  schema:name "Document. Type Name.Text";
  utd:bridges "UNLK: L 02, P 45-80 MAR: IMO/FAL 1-7";
  utd:businessTerm "Document/message name";
  utd:category <https://www.untded.org/categories/1000-1699>;
  utd:changeTag "cnd";
  utd:charset "an";
  utd:maxLength 35;
  utd:minLength 1;
  utd:oldName "Document/message name";
  utd:representation "an..35";
  utd:sourcePage 28;
  utd:status "active";
  utd:tag 1000 .

