      }
    },
    {
      "@id": "https://www.untded.org/ns/untded#representation",
      "@type": "rdf:Property",
      "comment": "The character representation as a structured node: printed form, charset, length bounds.",
      "domain": {
        "@id": "https://www.untded.org/ns/untded#TradeDataElement"
      }
    },
    {
      "@id": "https://www.untded.org/ns/untded#printedForm",
