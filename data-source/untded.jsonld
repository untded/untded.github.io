        "@id": "https://www.untded.org/ns/untded#TradeDataElement"
      }
    },
    {
      "@id": "https://www.untded.org/ns/untded#bridge",
      "@type": "rdf:Property",
      "comment": "One parsed location on a document scheme, with its zones when the scheme is the UN layout key.",
