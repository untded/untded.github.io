@prefix schema: <https://schema.org/> .
@prefix utd: <https://www.untded.org/ns/untded#> .

<https://www.untded.org/elements/3219> a utd:TradeDataElement;
  schema:description "To identify the country where a consignment is off-loaded from the means of transport used for its original exportation";
  schema:isPartOf <https://www.untded.org/dataset/untded-2005>;
  schema:name "Consignment. First Destination Country.Identifier";
  utd:bridges "SAD: (SAD 10) ISO Alpha-2 Country code, cf. Vol. II of UNTDED";
  utd:changeTag "cnd";
  utd:charset "an";
  utd:extractionConfidence "medium";
  utd:maxLength 3;
  utd:minLength 1;
  utd:oldName "Country of first destination, coded";
  utd:representation "an..3";
  utd:sourcePage 60;
  utd:status "active";
  utd:tag 3219 .
