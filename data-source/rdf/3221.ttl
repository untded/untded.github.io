<https://www.untded.org/elements/3221> a utd:TradeDataElement;
  skos:altLabel "Country whence consigned, coded";
  schema:description "To identify the country from which a consignment of goods was initially exported to the importing country without any commercial transaction taking place in intermediate countries. Syn.: country whence consigned. Country of despatch: country from which goods are despatched between countries of a Customs union";
