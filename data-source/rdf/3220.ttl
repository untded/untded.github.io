    utd:scheme "UNLK";
    utd:zone [
      a utd:UnlkZone;
      utd:lineFrom 16;
      utd:lineTo 16;
      utd:posFrom 45;
      utd:posTo 61
    ]
  ], [
    a utd:Bridge;
    utd:detail "(SAD 15)";
    utd:scheme "SAD"
  ];
  utd:bridges "UNLK: L 16, P 45 - 61 SAD: (SAD 15)";
