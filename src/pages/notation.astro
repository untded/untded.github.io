---
import BaseLayout from '../layouts/BaseLayout.astro'
import { loadCategories as CATEGORY_RANGES } from '../lib/element'
import { loadElements } from '../lib/data'

const tally = loadElements().reduce((acc, e) => ((acc[e.change_tag] = (acc[e.change_tag] ?? 0) + 1), acc), {} as Record<string, number>)
import { href } from '../lib/site'
---

<BaseLayout
  title="Notation — UN/TDED"
  description="How to read UNTDED 2005: representation notation (an..35), change tags, categories, and the layout-key bridges."
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Notation</h1>
    <p class="mt-2 text-body">How to read an entry in this directory.</p>

    <section class="mt-10" id="representation">
      <h2 class="text-xl font-semibold tracking-tight text-ink">Representation</h2>
      <p class="mt-3 leading-relaxed text-body">
        The representation defines the permitted form of a value:
        a character set and a length. <span class="font-mono text-sm">an..35</span> means
        alphanumeric, 1 to 35 characters; <span class="font-mono text-sm">n9</span> means
        numeric, exactly 9.
      </p>
      <table class="mt-4 w-full border-collapse text-sm">
        <thead>
          <tr class="border-b-2 border-line text-left text-xs uppercase tracking-wider text-body">
            <th scope="col" class="py-2 pe-4">Notation</th>
            <th scope="col" class="py-2">Meaning</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <tr><td class="py-2 pe-4 font-mono">a</td><td class="py-2">alphabetic characters</td></tr>
          <tr><td class="py-2 pe-4 font-mono">an</td><td class="py-2">alphanumeric characters</td></tr>
          <tr><td class="py-2 pe-4 font-mono">n</td><td class="py-2">numeric characters</td></tr>
          <tr><td class="py-2 pe-4 font-mono">..N</td><td class="py-2">variable length, up to N</td></tr>
          <tr><td class="py-2 pe-4 font-mono">N</td><td class="py-2">fixed length, exactly N</td></tr>
        </tbody>
      </table>
      <p class="mt-3 text-sm text-body">
        Four elements print no representation at all in the source
        (<span class="font-mono text-xs">5416, 6000, 6002, 6004</span>) — the
        cell is blank in the publication and remains blank here.
      </p>
    </section>

    <section class="mt-10" id="change-tags">
      <h2 class="text-xl font-semibold tracking-tight text-ink">Change tags</h2>
      <p class="mt-3 leading-relaxed text-body">
        Column 1 of the printed directory marks what changed since the 1993
        edition. The legend is the source’s own (section 4.1):
      </p>
      <table class="mt-4 w-full border-collapse text-sm">
        <thead>
          <tr class="border-b-2 border-line text-left text-xs uppercase tracking-wider text-body">
            <th scope="col" class="py-2 pe-4">Tag</th>
            <th scope="col" class="py-2">Meaning</th>
            <th scope="col" class="py-2 text-right">Count</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <tr><td class="py-2 pe-4 font-mono">add</td><td class="py-2">added</td><td class="py-2 text-right font-mono tabular-nums">{tally['add'] ?? 0}</td></tr>
          <tr><td class="py-2 pe-4 font-mono">cn</td><td class="py-2">changed name</td><td class="py-2 text-right font-mono tabular-nums">{tally['cn'] ?? 0}</td></tr>
          <tr><td class="py-2 pe-4 font-mono">cnd</td><td class="py-2">changed name + description</td><td class="py-2 text-right font-mono tabular-nums">{tally['cnd'] ?? 0}</td></tr>
          <tr><td class="py-2 pe-4 font-mono">cnr</td><td class="py-2">changed name + representation</td><td class="py-2 text-right font-mono tabular-nums">{tally['cnr'] ?? 0}</td></tr>
          <tr><td class="py-2 pe-4 font-mono">cndr</td><td class="py-2">changed name + description + representation</td><td class="py-2 text-right font-mono tabular-nums">{tally['cndr'] ?? 0}</td></tr>
          <tr><td class="py-2 pe-4 font-mono">u</td><td class="py-2">undeleted (re-instated)</td><td class="py-2 text-right font-mono tabular-nums">{tally['u'] ?? 0}</td></tr>
          <tr><td class="py-2 pe-4 font-mono">x</td><td class="py-2">marked for deletion (with tag + name)</td><td class="py-2 text-right font-mono tabular-nums">{tally['x'] ?? 0}</td></tr>
        </tbody>
      </table>
      <p class="mt-3 text-sm text-body">
        Three rows print tags outside this legend
        (<span class="font-mono text-xs">cd, cr ×2, cdr</span>). They are kept
        verbatim and flagged for review.
      </p>
    </section>

    <section class="mt-10" id="categories">
      <h2 class="text-xl font-semibold tracking-tight text-ink">Categories</h2>
      <table class="mt-4 w-full border-collapse text-sm">
        <thead>
          <tr class="border-b-2 border-line text-left text-xs uppercase tracking-wider text-body">
            <th scope="col" class="py-2 pe-4">Tags</th>
            <th scope="col" class="py-2">Category</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            CATEGORY_RANGES().map((c) => (
              <tr>
                <td class="py-2 pe-4 font-mono tabular-nums text-body">{c.range}</td>
                <td class="py-2">
                  <a class="hover:text-un-deep" href={href(`/categories/${c.range}`)}>{c.label}</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 text-sm text-body">
        Service elements (0001–0699) are not part of this edition — they are
        provided by ISO 9735 (EDIFACT syntax).
      </p>
    </section>

    <section class="mt-10" id="bridges">
      <h2 class="text-xl font-semibold tracking-tight text-ink">Bridges</h2>
      <p class="mt-3 leading-relaxed text-body">
        The rightmost column of the print maps each element onto the aligned
        trade documents where it physically lives — line and character
        positions on standard forms:
      </p>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="font-mono font-medium text-ink">UNLK — United Nations Layout Key</dt>
          <dd class="text-body">Positions on the UN Layout Key for trade documents (ISO 6422).</dd>
        </div>
        <div>
          <dt class="font-mono font-medium text-ink">SAD — Single Administrative Document</dt>
          <dd class="text-body">The EU customs declaration form; box and sub-division references.</dd>
        </div>
        <div>
          <dt class="font-mono font-medium text-ink">CIM — Consignment Note (rail)</dt>
          <dd class="text-body">The CIM rail consignment note (OTIF/COTIF Appendix B).</dd>
        </div>
        <div>
          <dt class="font-mono font-medium text-ink">CIMP — IATA cargo procedures</dt>
          <dd class="text-body">Field references in IATA Cargo Interchange Message Procedures.</dd>
        </div>
        <div>
          <dt class="font-mono font-medium text-ink">MAR — IMO FAL documents</dt>
          <dd class="text-body">Maritime declarations under the IMO Convention on Facilitation
            of International Maritime Traffic.</dd>
        </div>
      </dl>
    </section>
  </div>
</BaseLayout>