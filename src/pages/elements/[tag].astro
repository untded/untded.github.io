---
import BaseLayout from '../../layouts/BaseLayout.astro'
import TagPlate from '../../components/TagPlate.astro'
import ReprChip from '../../components/ReprChip.astro'
import ChangeTagBadge from '../../components/ChangeTagBadge.astro'
import OldNameBlock from '../../components/OldNameBlock.astro'
import BridgeList from '../../components/BridgeList.astro'
import ProvenanceCard from '../../components/ProvenanceCard.astro'
import { loadElements, jsonldNode } from '../../lib/data'
import { categoryOf, changeTagInfo, elementUrl, neighbours, pairedTag, replacementPointer } from '../../lib/element'
import { href } from '../../lib/site'
import { DATASET_FILE_BASE } from '../../lib/site'

export function getStaticPaths() {
  return loadElements().map((element) => ({
    params: { tag: String(element.tag) },
    props: { element },
  }))
}

const { element } = Astro.props
const category = categoryOf(element.tag)
const info = changeTagInfo(element.change_tag)
const replacement = replacementPointer(element)
const allTags = loadElements().map((e) => e.tag)
const { prev, next } = neighbours(element.tag, allTags)
const pair = pairedTag(element.tag, new Set(allTags))
const dataFile = `${DATASET_FILE_BASE}/${category.range}.yaml`
const jsonld = jsonldNode(`${Astro.site?.toString().replace(/\/$/, '')}/elements/${element.tag}`)
const iri = `${Astro.site?.toString().replace(/\/$/, '')}/elements/${element.tag}`
---

<BaseLayout
  title={`${element.tag}${element.name ? ` — ${element.name}` : ' (retired)'} · UN/TDED`}
  description={
    element.description
      ?? `${element.name ?? 'Retired element'} — UNTDED 2005 data element ${element.tag}.`
  }
  alternates={[
    { type: 'application/ld+json', href: href(`/elements/${element.tag}/data.jsonld`) },
    { type: 'text/turtle', href: href(`/elements/${element.tag}/data.ttl`) },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-6 text-sm text-body" aria-label="Breadcrumb">
      <a class="hover:text-un-deep" href={href('/elements')}>Directory</a>
      <span class="mx-1.5 text-line" aria-hidden="true">/</span>
      <a class="hover:text-un-deep" href={href(`/categories/${category.range}`)}>{category.range}</a>
    </nav>

    <nav class="mb-6 flex items-center justify-between gap-4 text-sm" aria-label="Adjacent elements">
      {
        prev ? (
          <a class="min-w-0 truncate text-body hover:text-un-deep" href={elementUrl(prev)}>
            <span aria-hidden="true">← </span>
            <span class="font-mono tabular-nums">{prev}</span>
          </a>
        ) : (
          <span />
        )
      }
      <button
        type="button"
        class="copy-tag rounded-md border border-line bg-mist px-2.5 py-1 font-mono text-xs text-body hover:border-un/60 hover:text-un-deep"
        data-tag={element.tag}
      >
        Copy tag {element.tag}
      </button>
      {
        next ? (
          <a class="min-w-0 truncate text-right text-body hover:text-un-deep" href={elementUrl(next)}>
            <span class="font-mono tabular-nums">{next}</span>
            <span aria-hidden="true"> →</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <div class="grid gap-8 lg:grid-cols-[16rem_1fr]">
      <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
        <TagPlate tag={element.tag} size="lg" />
        <div class="flex flex-wrap items-center gap-2">
          <ChangeTagBadge changeTag={element.change_tag} />
          <span
            class:list={[
              'rounded-sm border px-1.5 py-0.5 font-mono text-xs',
              element.status === 'retired'
                ? 'border-stamp/50 bg-stamp/10 text-stamp'
                : 'border-line bg-mist text-body',
            ]}
          >
            {element.status === 'retired' ? 'retired' : 'active'}
          </span>
        </div>
        <p class="text-sm text-body">
          <span class={`me-1 inline-block h-2 w-2 rounded-full bg-cat-${category.k} align-middle`} aria-hidden="true"></span>
          <a class="hover:text-un-deep" href={href(`/categories/${category.range}`)}>
            {category.label}
          </a>
        </p>
        <div>
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-body">Representation</h2>
          <ReprChip repr={element.representation} size="lg" />
        </div>
        <ProvenanceCard provenance={element.provenance} />
        <div>
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-body">Linked data</h2>
          <p class="break-all font-mono text-[0.7rem] leading-snug text-ink">{iri}</p>
          <button
            type="button"
            class="copy-iri mt-1 rounded-sm border border-line bg-mist px-1.5 py-0.5 font-mono text-xs text-body hover:border-un/60 hover:text-un-deep"
            data-iri={iri}
          >
            Copy IRI
          </button>
          <ul class="mt-2 space-y-1 text-xs">
            <li><a class="text-un-deep underline decoration-un/50" href={href(`/elements/${element.tag}/data.jsonld`)}>data.jsonld</a></li>
            <li><a class="text-un-deep underline decoration-un/50" href={href(`/elements/${element.tag}/data.ttl`)}>data.ttl</a></li>
          </ul>
        </div>
        <div class="text-xs">
          <a class="text-un-deep underline decoration-un/50" href={dataFile}>YAML record ↗</a>
        </div>
      </aside>

      <article>
        {
          element.name ? (
            <h1 class="text-3xl font-semibold leading-tight tracking-tight text-ink">
              {element.name}
            </h1>
          ) : (
            <h1 class="text-3xl font-semibold tracking-tight text-stamp">
              Retired element — no 2005 name
            </h1>
          )
        }

        {
          element.description ? (
            <p class="prose-def mt-4">{element.description}</p>
          ) : (
            <p class="mt-4 text-body">No definition is printed for this element in the 2005 edition.</p>
          )
        }

        {
          pair && (
            <p class="mt-4 rounded-md border border-line bg-white p-4 text-sm text-body">
              The 2005 edition pairs clear-text and coded versions on adjacent tags
              (section 4.2.2): this element’s counterpart is{' '}
              <a class="font-mono text-un-deep underline decoration-un/50" href={elementUrl(pair)}>
                {pair}
              </a>
              .
            </p>
          )
        }

        {
          replacement && (
            <p class="mt-4 rounded-md border border-un/40 bg-un/5 p-4 text-sm">
              <strong class="text-ink">Marked for deletion.</strong>{' '}
              The printed note directs implementers to use{' '}
              <a class="font-mono text-un-deep underline decoration-un/50" href={elementUrl(replacement)}>
                element {replacement}
              </a>{' '}
              instead.
            </p>
          )
        }

        {
          !replacement && element.status === 'retired' && element.notes && (
            <p class="mt-4 rounded-md border border-line bg-mist p-4 text-sm text-body">
              <strong class="text-ink">Note (1993):</strong> {element.notes}
            </p>
          )
        }

        {
          element.status === 'active' && element.notes && (
            <p class="mt-4 text-sm text-body">
              <strong class="text-ink">Note:</strong> {element.notes}
            </p>
          )
        }

        <div class="mt-8">
          <OldNameBlock oldName={element.old_name} businessTerm={element.business_term} />
        </div>

        <section class="mt-8" aria-label="Bridges">
          <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-body">
            Locations &amp; bridges
          </h2>
          <BridgeList bridges={element.bridges} />
          <p class="mt-3 text-xs text-body/80">
            Where the element lives on aligned documents — see the{' '}
            <a class="text-un-deep underline decoration-un/50" href={href('/notation/#bridges')}>bridge glossary</a>.
          </p>
        </section>

        {
          info.outsideLegend && (
            <p class="mt-8 rounded-md border border-stamp/40 bg-stamp/5 p-4 text-sm text-body">
              This element’s change tag <span class="font-mono">{element.change_tag}</span> is
              printed outside the legend of section 4.1. It is transcribed verbatim;{' '}
              <a class="text-un-deep underline decoration-un/50" href={href('/method/#anomalies')}>
                glyph analysis confirmed the print
              </a>.
            </p>
          )
        }

        <nav class="mt-10 flex items-center justify-between gap-4 border-t border-line pt-4 text-sm" aria-label="Adjacent elements">
          {
            prev ? (
              <a class="min-w-0 truncate text-body hover:text-un-deep" href={elementUrl(prev)}>
                <span aria-hidden="true">← </span>
                <span class="font-mono tabular-nums">{prev}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a class="min-w-0 truncate text-right text-body hover:text-un-deep" href={elementUrl(next)}>
                <span class="font-mono tabular-nums">{next}</span>
                <span aria-hidden="true"> →</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </article>
    </div>
  </div>
  {
    jsonld && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    )
  }
</BaseLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy-tag')) {
    btn.addEventListener('click', async () => {
      const tag = btn.dataset.tag ?? ''
      try {
        await navigator.clipboard.writeText(tag)
        const original = btn.textContent
        btn.textContent = `Copied ${tag}`
        setTimeout(() => (btn.textContent = original), 1200)
      } catch {
        window.prompt('Copy the tag:', tag)
      }
    })
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy-iri')) {
    btn.addEventListener('click', async () => {
      const iri = btn.dataset.iri ?? ''
      try {
        await navigator.clipboard.writeText(iri)
        const original = btn.textContent
        btn.textContent = 'Copied IRI'
        setTimeout(() => (btn.textContent = original), 1200)
      } catch {
        window.prompt('Copy the IRI:', iri)
      }
    })
  }
</script>