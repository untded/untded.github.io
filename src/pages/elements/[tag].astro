---
import BaseLayout from '../../layouts/BaseLayout.astro'
import TagPlate from '../../components/TagPlate.astro'
import ReprChip from '../../components/ReprChip.astro'
import ChangeTagBadge from '../../components/ChangeTagBadge.astro'
import ElementPager from '../../components/ElementPager.astro'
import OldNameBlock from '../../components/OldNameBlock.astro'
import BridgeList from '../../components/BridgeList.astro'
import UnlkForm from '../../components/UnlkForm.astro'
import PositionRuler from '../../components/PositionRuler.astro'
import { unlkRects, unlkZones } from '../../lib/unlk'
import ProvenanceCard from '../../components/ProvenanceCard.astro'
import { loadElements, jsonldNode } from '../../lib/data'
import { changeTagInfo, elementUrl, neighbours, pairedTag, parseBridges, replacementPointer } from '../../lib/element'
import { categoryOf } from '../../lib/data'
import { loadEdifactLinks } from '../../lib/edifact'
import { loadUnclCoverage } from '../../lib/uncl'
import { DATASET_FILE_BASE, href } from '../../lib/site'

export function getStaticPaths() {
  return loadElements().map((element) => ({
    params: { tag: String(element.tag) },
    props: { element },
  }))
}

const { element } = Astro.props
const category = categoryOf(element.tag)
const info = changeTagInfo(element.change_tag)
const allTags = loadElements().map((e) => e.tag)
const replacement = replacementPointer(element, new Set(allTags))
const unlk = unlkZones(element.bridges)
const unlkR = unlkRects(element.bridges)
const edifact = loadEdifactLinks().get(element.tag)
const uncl = loadUnclCoverage().get(element.tag)
const schemes = [...new Set(parseBridges(element.bridges).map((b) => b.scheme))]
const unlkDeep = unlk[0] && `${href('/unlk')}#field=${[unlk[0].lineFrom, unlk[0].lineTo, unlk[0].posFrom, unlk[0].posTo].join(':')}`
const { prev, next } = neighbours(element.tag, allTags)
const pair = pairedTag(element.tag, new Set(allTags))
const dataFile = `${DATASET_FILE_BASE}/${category.range}.yaml`
const jsonld = jsonldNode(`${Astro.site?.toString().replace(/\/$/, '')}/elements/${element.tag}`)
const iri = `${Astro.site?.toString().replace(/\/$/, '')}/elements/${element.tag}`
---

<BaseLayout
  title={`${element.tag}${element.name ? ` — ${element.name}` : ' (retired)'} · UN/TDED`}
  description={
    element.description
      ?? `${element.name ?? 'Retired element'} — UNTDED 2005 data element ${element.tag}.`
  }
  alternates={[
    { type: 'application/ld+json', href: href(`/elements/${element.tag}/data.jsonld`) },
    { type: 'text/turtle', href: href(`/elements/${element.tag}/data.ttl`) },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-6 text-sm text-body" aria-label="Breadcrumb">
      <a class="hover:text-un-deep" href={href('/elements')}>Directory</a>
      <span class="mx-1.5 text-line" aria-hidden="true">/</span>
      <a class="hover:text-un-deep" href={href(`/categories/${category.range}`)}>{category.range}</a>
    </nav>

    <div class="mb-6">
      <ElementPager prev={prev} next={next} />
    </div>

    <div class="grid gap-8 lg:grid-cols-[16rem_1fr]">
      <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
        <TagPlate tag={element.tag} size="lg" />
        <div class="flex flex-wrap items-center gap-2">
          <a href={href('/ledger#tag-' + element.change_tag)} class="shrink-0"><ChangeTagBadge changeTag={element.change_tag} expand /></a>
          <span
            class:list={[
              'rounded-sm border px-1.5 py-0.5 font-mono text-xs',
              element.status === 'retired'
                ? 'border-stamp/50 bg-stamp/10 text-stamp'
                : 'border-line bg-mist text-body',
            ]}
          >
            {element.status === 'retired' ? 'retired' : 'active'}
          </span>
        </div>
        <p class="text-sm text-body">
          <span class={`me-1 inline-block h-2 w-2 rounded-full bg-cat-${category.k} align-middle`} aria-hidden="true"></span>
          <a class="hover:text-un-deep" href={href(`/categories/${category.range}`)}>
            {category.label}
          </a>
        </p>
        <div>
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-body">Representation</h2>
          <ReprChip repr={element.representation} size="lg" />
        </div>
        <ProvenanceCard provenance={element.provenance} />
        <div>
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-body">Linked data</h2>
          <p class="break-all font-mono text-[0.7rem] leading-snug text-ink">{iri}</p>
          <button
            type="button"
            class="copy-btn filter-btn mt-1 font-mono text-xs"
            data-copy={iri}
          >
            Copy IRI
          </button>
          <ul class="mt-2 space-y-1 text-xs">
            <li><a class="text-un-deep underline decoration-un/50" href={href(`/elements/${element.tag}/data.jsonld`)}>data.jsonld</a></li>
            <li><a class="text-un-deep underline decoration-un/50" href={href(`/elements/${element.tag}/data.ttl`)}>data.ttl</a></li>
          </ul>
        </div>
        <div class="text-xs">
          <a class="text-un-deep underline decoration-un/50" href={dataFile}>YAML record ↗</a>
        </div>
      </aside>

      <article>
        {
          element.name ? (
            <>
              <h1 class="text-3xl font-semibold leading-tight tracking-tight text-ink">
                {element.name}
              </h1>
              {element.old_name && element.old_name !== element.name && (
                <p class="mt-1 text-sm text-body">1993 name: {element.old_name}</p>
              )}
            </>
          ) : (
            <h1 class="text-3xl font-semibold tracking-tight text-stamp">
              Retired element — no 2005 name
            </h1>
          )
        }

        {
          element.description ? (
            <p class="prose-def mt-4">{element.description}</p>
          ) : (
            <p class="mt-4 text-body">No definition is printed for this element in the 2005 edition.</p>
          )
        }

        {
          pair && (
            <p class="mt-4 rounded-md border border-line bg-paper p-4 text-sm text-body">
              The 2005 edition pairs clear-text and coded versions on adjacent tags
              (section 4.2.2): this element’s counterpart is{' '}
              <a class="font-mono text-un-deep underline decoration-un/50" href={elementUrl(pair)}>
                {pair}
              </a>
              .
            </p>
          )
        }

        {
          replacement && (
            <p class="mt-4 rounded-md border border-un/40 bg-un/5 p-4 text-sm">
              <strong class="text-ink">Marked for deletion.</strong>{' '}
              The printed note directs implementers to use{' '}
              <a class="font-mono text-un-deep underline decoration-un/50" href={elementUrl(replacement)}>
                element {replacement}
              </a>{' '}
              instead.
            </p>
          )
        }

        {
          !replacement && element.status === 'retired' && element.notes && (
            <p class="mt-4 rounded-md border border-line bg-mist p-4 text-sm text-body">
              <strong class="text-ink">Note (1993):</strong> {element.notes}
            </p>
          )
        }

        {
          element.status === 'active' && element.notes && (
            <p class="mt-4 text-sm text-body">
              <strong class="text-ink">Note:</strong> {element.notes}
            </p>
          )
        }

        <div class="mt-8">
          <OldNameBlock oldName={element.old_name} businessTerm={element.business_term} />
        </div>

        <section class="mt-8" aria-label="Bridges">
          <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-body">
            Locations &amp; bridges
          </h2>
          <BridgeList bridges={element.bridges} />
          {schemes.length > 0 && (
            <p class="mt-3 text-xs text-body/80">
              All elements on{' '}
              {schemes.map((sc, i) => (
                <>
                  {i > 0 && <span>{' · '}</span>}
                  <a class="text-un-deep underline decoration-un/50" href={href('/bridges#' + sc.replace(/[^A-Za-z0-9]/g, ''))}>{sc}</a>
                </>
              ))}{' '}
              — see the{' '}
              <a class="text-un-deep underline decoration-un/50" href={href('/notation/#bridges')}>bridge glossary</a>.
            </p>
          )}
          {(edifact || uncl !== undefined) && (
            <p class="mt-3 flex flex-wrap items-center gap-2">
              {edifact && (
                <a
                  class:list={[
                    'inline-flex items-baseline gap-2 rounded-full border px-3 py-1 text-xs',
                    edifact.aligned ? 'border-line bg-mist text-body' : 'border-stamp/50 bg-stamp/5 text-stamp',
                  ]}
                  href={href(edifact.aligned ? '/docs/alignment-edifact' : '/docs/alignment-edifact#diff-' + edifact.tag)}
                >
                  <span class="font-mono font-semibold">EDED {edifact.tag}</span>
                  <span class="font-mono">{edifact.edifact.type}..{edifact.edifact.maxLength}</span>
                  <span>{edifact.aligned ? 'aligned' : 'representation differs'}</span>
                </a>
              )}
              {uncl !== undefined && (
                <a
                  class="inline-flex items-baseline gap-2 rounded-full border border-line bg-mist px-3 py-1 text-xs text-body"
                  title="Code-qualified in the UN/EDIFACT D.05B UNCL (Volume II of the publication is the code-list volume)"
                  href={href('/docs/alignment-edifact#code-lists-uncl')}
                >
                  <span class="font-mono font-semibold">UNCL D05B</span>
                  <span>{uncl === 1 ? '1 code value' : `${uncl} code values`}</span>
                </a>
              )}
            </p>
          )}
          <p class="mt-3 text-xs text-body/80">
            Machine formats:{' '}
            <a class="text-un-deep underline decoration-un/50" href={href('/elements/' + element.tag + '/data.ttl')}>Turtle</a>
            {' · '}
            <a class="text-un-deep underline decoration-un/50" href={href('/elements/' + element.tag + '/data.jsonld')}>JSON-LD</a>.
          </p>
        </section>

        {unlk.length > 0 && (
          <section class="mt-8" aria-label="Location on the UN layout key">
            <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-body">
              On the UN layout key
            </h2>
            <div class="flex flex-wrap items-start gap-6">
              <UnlkForm zones={unlkR} />
              <div class="min-w-[12rem] flex-1 space-y-3">
                {unlk.map((z) => (
                  <div>
                    <p class="text-sm text-body">
                      line{z.lineTo > z.lineFrom ? 's' : ''} {z.lineFrom}{z.lineTo > z.lineFrom ? `–${z.lineTo}` : ''},
                      position{z.posTo > z.posFrom ? 's' : ''} {z.posFrom}{z.posTo > z.posFrom ? `–${z.posTo}` : ''}
                      {z.format && <span> — field format <span class="font-mono text-xs">{z.format}</span></span>}
                    </p>
                    <PositionRuler from={z.posFrom} to={z.posTo} format={z.format} />
                  </div>
                ))}
                <p class="text-xs text-body/80">
                  The standard A4 form of ISO 6422 — the same data realized as a printed
                  document. See the{' '}
                  <a class="text-un-deep underline decoration-un/50" href={unlkDeep ?? href('/unlk')}>full reconstruction</a>.
                </p>
              </div>
            </div>
          </section>
        )}

        {
          info.outsideLegend && (
            <p class="mt-8 rounded-md border border-stamp/40 bg-stamp/5 p-4 text-sm text-body">
              This element’s change tag <span class="font-mono">{element.change_tag}</span> is
              printed outside the legend of section 4.1. It is transcribed verbatim
              and flagged for review.
            </p>
          )
        }

        <div class="mt-10 border-t border-line pt-4">
          <ElementPager prev={prev} next={next} />
        </div>
      </article>
    </div>
  </div>
  {
    jsonld && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    )
  }
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Directory', item: `${Astro.site}/elements` },
        { '@type': 'ListItem', position: 2, name: category.range, item: `${Astro.site}/categories/${category.range}` },
        { '@type': 'ListItem', position: 3, name: String(element.tag) },
      ],
    })}
  />
</BaseLayout>

