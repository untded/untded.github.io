---
import '../../styles/filter.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ChangeTagBadge from '../../components/ChangeTagBadge.astro'
import CompositionBar from '../../components/CompositionBar.astro'
import { loadCategories as CATEGORY_RANGES, categoryOf } from '../../lib/element'
import { loadElements, jsonldNode } from '../../lib/data'
import { href } from '../../lib/site'

export function getStaticPaths() {
  return CATEGORY_RANGES().map((category) => ({
    params: { range: category.range },
    props: { category },
  }))
}

const { category } = Astro.props
const elements = loadElements()
  .filter((e) => categoryOf(e.tag).k === category.k)
  .sort((a, b) => a.tag - b.tag)
const groups = elements.reduce(
  (acc, e) => {
    const key = e.change_tag === 'add' ? 'added' : e.change_tag === 'x' ? 'retired' : 'changed'
    acc[key] += 1
    return acc
  },
  { added: 0, changed: 0, undeleted: 0, retired: 0 },
)
const origin = Astro.site?.toString().replace(/\/$/, '')
const categoryJsonld = jsonldNode(`${origin}/categories/${category.range}`)
---

<BaseLayout
  title={`${category.range} — ${category.label} · UN/TDED`}
  description={`TDED category ${category.range} (${category.label}) of UNTDED 2005: ${elements.length} data elements.`}
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <p class="font-mono text-sm tabular-nums text-body">{category.range}</p>
    <div class={`mt-2 h-1.5 w-24 rounded-full bg-cat-${category.k}`} aria-hidden="true"></div>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">{category.label}</h1>
    <div class="mt-2 max-w-md">
      <CompositionBar groups={groups} count={elements.length} />
    </div>
    <p class="mt-2 text-body">
      {elements.length} elements
      ({elements.filter((e) => e.status === 'active').length} active) ·{' '}
      <a class="text-un-deep underline decoration-un/50" href={href(`/elements?cat=${category.k}`)}>
        filter this category in the directory
      </a>
    </p>

    <div class="mt-6 overflow-x-auto">
      <table class="dir-table">
      <thead>
        <tr>
          <th scope="col">Tag</th>
          <th scope="col">Name</th>
          <th scope="col">Repr.</th>
          <th scope="col">Change</th>
        </tr>
      </thead>
      <tbody>
        {
          elements.map((e) => (
            <tr class={e.status === 'retired' ? 'retired' : ''}>
              <td class="font-mono tabular-nums">
                <a href={href(`/elements/${e.tag}`)}>{e.tag}</a>
              </td>
              <td class="name-cell">
                <a href={href(`/elements/${e.tag}`)}>{e.name ?? '(retired — see entry)'}</a>
              </td>
              <td class="font-mono text-xs text-body">{e.representation?.raw ?? '—'}</td>
              <td>
                <ChangeTagBadge changeTag={e.change_tag} />
              </td>
            </tr>
          ))
        }
      </tbody>
      </table>
    </div>
  </div>
  {
    categoryJsonld && (
      <script type="application/ld+json" set:html={JSON.stringify(categoryJsonld)} />
    )
  }
</BaseLayout>