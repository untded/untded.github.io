---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Not found — unt·ded" description="Page not found.">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="font-mono text-6xl font-semibold text-un">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight text-ink">No such entry</h1>
    <p class="mt-2 text-body" id="suggestion">
      Try the <a class="text-un-deep underline decoration-un/50" href="/elements">directory</a>,
      search the <a class="text-un-deep underline decoration-un/50" href="/search">full text</a>,
      or press <kbd class="rounded border border-line bg-mist px-1.5 font-mono text-sm">⌘K</kbd>.
    </p>
  </div>
</BaseLayout>

<script>
  const m = window.location.pathname.match(/^\/(\d{4})\/?$/)
  if (m) {
    const el = document.getElementById('suggestion')
    if (el) {
      const a = document.createElement('a')
      a.href = `/elements/${m[1]}`
      a.className = 'font-mono text-un-deep underline decoration-un/50'
      a.textContent = `/elements/${m[1]}`
      el.prepend('That looks like a tag — go to ', a, '. ')
    }
  }
</script>
