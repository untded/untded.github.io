---
import BaseLayout from '../layouts/BaseLayout.astro'
import { href } from '../lib/site'
---

<BaseLayout title="Not found — UN/TDED" description="Page not found.">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="font-mono text-6xl font-semibold text-un">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight text-ink">Page not found</h1>
    <p class="mt-2 text-body" id="suggestion">
      Use the <a class="text-un-deep underline decoration-un/50" href={href('/elements')}>directory</a>,
      search the <a class="text-un-deep underline decoration-un/50" href={href('/search')}>full text</a>,
      or press <kbd class="rounded border border-line bg-mist px-1.5 font-mono text-sm">⌘K</kbd> to look up an element.
    </p>
  </div>
</BaseLayout>

<script data-astro-rerun>
  import { href } from '../lib/site'
  const m = window.location.pathname.match(/^\/(\d{4})\/?$/)
  if (m) {
    const el = document.getElementById('suggestion')
    if (el) {
      const a = document.createElement('a')
      a.href = href(`/elements/${m[1]}`)
      a.className = 'font-mono text-un-deep underline decoration-un/50'
      a.textContent = `/elements/${m[1]}`
      el.prepend('That looks like a tag — go to ', a, '. ')
    }
  }
</script>