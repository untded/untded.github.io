---
import BaseLayout from '../layouts/BaseLayout.astro'
import { loadElements, loadCategories } from '../lib/data'
import { unlkZones } from '../lib/unlk'
import { categoryOf } from '../lib/data'
import { href } from '../lib/site'

const elements = loadElements()

// The UNLK-bridged elements, grouped by form line — the implementer's
// reference for the master document's fields.
const bridged = elements.filter((e) => {
  const zones = unlkZones(e.bridges)
  return zones.length > 0 && e.status === 'active'
})

const byLine = new Map<number, typeof bridged>()
for (const e of bridged) {
  const line = unlkZones(e.bridges)[0]?.lineFrom ?? 0
  const list = byLine.get(line) ?? []
  list.push(e)
  byLine.set(line, list)
}
const lines = [...byLine.entries()].sort((a, b) => a[0] - b[0])

const repr = (e: (typeof elements)[number]) => {
  if (!e.representation) return '—'
  const r = e.representation
  return `${r.charset}${r.min_length === r.max_length ? r.max_length : `..${r.max_length}`}`
}
const pos = (e: (typeof elements)[number]) => {
  const z = unlkZones(e.bridges)[0]
  if (!z) return ''
  return z.posTo > z.posFrom ? `P ${z.posFrom}–${z.posTo}` : `P ${z.posFrom}`
}
---

<BaseLayout
  title="Reference card — UN/TDED"
  description="The UNLK-bridged elements as a printable reference: tag, name, representation and form position, grouped by line."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-un-deep">Reference</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Printable reference card</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-body">
      The {bridged.length} elements the directory places on the UN layout key — the
      master document's fields — grouped by form line. Print this page for a
      one-sheet working reference.
    </p>

    <div class="mt-8 space-y-6">
      {lines.map(([line, els]) => (
        <section>
          <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-un-deep">
            Line {line}
          </h2>
          <table class="w-full border-collapse text-sm">
            <tbody class="divide-y divide-line">
              {els.map((e) => (
                <tr>
                  <td class="py-1.5 pe-4 font-mono tabular-nums text-body">
                    <a class="text-un-deep underline decoration-un/50" href={href(`/elements/${e.tag}`)}>{e.tag}</a>
                  </td>
                  <td class="py-1.5 pe-4 text-ink">{e.name ?? '(retired)'}</td>
                  <td class="py-1.5 pe-4 font-mono text-xs text-body">{repr(e)}</td>
                  <td class="py-1.5 text-right font-mono text-xs text-body/80">{pos(e)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  @media print {
    body { font-size: 9pt; }
    section { break-inside: avoid; }
    h2 { margin-top: 0.5rem; }
    td { padding: 0.1rem 0.3rem !important; }
    a { color: #000 !important; text-decoration: none !important; }
  }
</style>
