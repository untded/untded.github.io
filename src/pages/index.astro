---
import BaseLayout from '../layouts/BaseLayout.astro'
import RenameLedger from '../islands/RenameLedger.vue'
import StatStrip from '../components/StatStrip.astro'
import CategoryGrid from '../components/CategoryGrid.astro'
import { loadElements } from '../lib/data'
import { buildLedger } from '../lib/ledgers'
import { CATEGORY_RANGES } from '../lib/element'
import { buildMeta } from '../../scripts/lib/meta.mjs'

const elements = loadElements()
const ledger = buildLedger(elements)
const meta = buildMeta(elements)
---

<BaseLayout
  title="unt·ded — the UN Trade Data Elements Directory, machine-readable"
  description="The United Nations Trade Data Elements Directory 2005 (ISO 7372:2005): 1504 trade data elements, digitized with verifiable provenance. Operated on behalf of UN/CEFACT and ISO/TC 154."
>
  <section class="border-b border-line bg-mist">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-14">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-un-deep">
        United Nations Trade Data Elements Directory · 2005 edition
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">
        The vocabulary of trade,<br class="hidden sm:block" />
        machine-readable.
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-body">
        Every data element on a trade document — its number, name, definition and
        representation — in one verified dataset. Press
        <kbd class="rounded border border-line bg-white px-1.5 font-mono text-sm">⌘K</kbd>
        to look one up, or browse the
        <a class="text-un-deep underline decoration-un/50" href="/elements">directory</a>.
      </p>
      <div class="mt-8 max-w-3xl">
        <RenameLedger client:visible="idle" lines={ledger} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10" aria-label="The directory in numbers">
    <StatStrip
      stats={[
        { value: String(meta.count), label: 'elements', href: '/elements' },
        { value: String(meta.categories.length), label: 'categories', href: '/elements' },
        { value: String(meta.groups.added), label: 'added in 2005' },
        { value: String(meta.groups.changed), label: 'renamed / changed' },
        { value: String(meta.groups.retired), label: 'retired' },
      ]}
    />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10" aria-label="Categories">
    <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Nine categories, tags 1000–9699</h2>
    <CategoryGrid categories={meta.categories} />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14" aria-label="Why trust this data">
    <div class="grid gap-4 md:grid-cols-2">
      <a href="/method" class="rounded-md border border-line bg-white p-5 transition-colors hover:border-un/60">
        <h3 class="text-base font-semibold text-ink">How you can verify this data →</h3>
        <p class="mt-2 text-sm leading-relaxed text-body">
          Character conservation (169,020 characters, exact), row reconciliation
          (1504 = 1504), independent OCR re-reads, and a cross-check against the
          UN/EDIFACT D.05B directory. Every element carries its source page and
          extraction confidence.
        </p>
      </a>
      <a href="/download" class="rounded-md border border-line bg-white p-5 transition-colors hover:border-un/60">
        <h3 class="text-base font-semibold text-ink">Take the dataset →</h3>
        <p class="mt-2 text-sm leading-relaxed text-body">
          YAML single source of truth, CSV and JSON exports, per-element pages —
          plus the digitization code and its test suite, all open source under
          the <span class="font-mono text-xs">untded</span> organization.
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
