---
import BaseLayout from '../layouts/BaseLayout.astro'
import { loadElements } from '../lib/data'
import { href } from '../lib/site'

const elements = loadElements()
---

<BaseLayout
  title="Download — UN/TDED"
  description="The UNTDED 2005 dataset: YAML single source of truth, CSV and JSON exports, and the source PDFs."
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Download</h1>
    <p class="mt-2 max-w-2xl text-body">
      The dataset is data, not a document — take it in whatever form fits.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a
        href="https://github.com/untded/untded-2005"
        class="rounded-md border border-line bg-white p-5 transition-colors hover:border-un/60"
      >
        <h2 class="font-semibold text-ink">YAML — full dataset ↗</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">untded/untded-2005</span> — nine
          category files covering every element, each with its source page and
          extraction confidence, plus the extraction and verification code
          (Ruby, lutaml-model).
        </p>
      </a>
      <a
        href="https://github.com/untded/untded-2005/releases"
        class="rounded-md border border-line bg-white p-5 transition-colors hover:border-un/60"
      >
        <h2 class="font-semibold text-ink">CSV &amp; JSON exports ↗</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          Release artifacts:{' '}
          <span class="font-mono text-xs">elements.csv</span>{' '}
          (one row per element) and{' '}
          <span class="font-mono text-xs">elements.json</span>{' '}
          (full records), regenerated byte-identically by{' '}
          <span class="font-mono text-xs">bin/export</span>.
        </p>
      </a>
      <a href={href('/data/index.json')} class="rounded-md border border-line bg-white p-5 transition-colors hover:border-un/60">
        <h2 class="font-semibold text-ink">Compact index</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">/data/index.json</span> — a light
          JSON list of all {elements.length} elements: tag, name,
          representation, change tag, status, category.
        </p>
      </a>
      <a
        href="https://github.com/untded/references"
        class="rounded-md border border-line bg-white p-5 transition-colors hover:border-un/60"
      >
        <h2 class="font-semibold text-ink">Source PDFs &amp; provenance ↗</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">untded/references</span> — both PDFs,
          the front-matter OCR, the printed legend, and the D.05B cross-check
          corpus.
        </p>
      </a>
    </div>

    <section class="mt-10 rounded-md border border-line bg-mist p-6 text-sm leading-relaxed text-body">
      <h2 class="font-semibold text-ink">Attribution</h2>
      <p class="mt-2">
        Content: UNTDED 2005, ECE/TRADE/362 (in parallel ISO 7372:2005),
        © United Nations / UNECE. Digitized by this project on behalf of
        UN/CEFACT and ISO/TC 154; reproduced with attribution. Code: MIT.
        When you use the dataset, cite the source publication and this
        digitization.
      </p>
    </section>
  </div>
</BaseLayout>