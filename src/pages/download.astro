---
import BaseLayout from '../layouts/BaseLayout.astro'
import { loadElements } from '../lib/data'
import { href } from '../lib/site'

const elements = loadElements()
---

<BaseLayout
  title="Download — UN/TDED"
  description="The UNTDED 2005 dataset as YAML, CSV, JSON, JSON-LD and RDF Turtle, plus the source publication."
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Download</h1>
    <p class="mt-2 max-w-2xl text-body">
      The dataset is data, not a document — take it in whatever form fits.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a
        href="https://github.com/untded/untded-2005"
        class="rounded-md border border-line bg-paper p-5 transition-colors hover:border-un/60"
      >
        <h2 class="font-semibold text-ink">YAML — full dataset ↗</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">untded/untded-2005</span> — nine
          category files covering every element, each naming its page in the
          source publication.
        </p>
      </a>
      <a
        href="https://github.com/untded/untded-2005/releases"
        class="rounded-md border border-line bg-paper p-5 transition-colors hover:border-un/60"
      >
        <h2 class="font-semibold text-ink">CSV &amp; JSON exports ↗</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          Release artifacts:{' '}
          <span class="font-mono text-xs">elements.csv</span>{' '}
          (one row per element) and{' '}
          <span class="font-mono text-xs">elements.json</span>{' '}
          (full records), straight from the dataset.
        </p>
      </a>
      <a href={href('/data/untded.jsonld')} class="rounded-md border border-line bg-paper p-5 transition-colors hover:border-un/60">
        <h2 class="font-semibold text-ink">JSON-LD</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">/data/untded.jsonld</span> — the whole
          directory as a linked-data graph: every element an identified
          resource with schema.org and UNTDED vocabulary terms.
        </p>
      </a>
      <a href={href('/data/untded.ttl')} class="rounded-md border border-line bg-paper p-5 transition-colors hover:border-un/60">
        <h2 class="font-semibold text-ink">RDF Turtle</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">/data/untded.ttl</span> — the same
          graph as Turtle, for SPARQL stores and RDF tooling. The vocabulary is
          defined in the dataset’s YAML-LD context.
        </p>
      </a>
      <a href={href('/data/index.json')} class="rounded-md border border-line bg-paper p-5 transition-colors hover:border-un/60">
        <h2 class="font-semibold text-ink">Compact index</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">/data/index.json</span> — a light
          JSON list of all {elements.length} elements: tag, name,
          representation, change tag, status, category.
        </p>
      </a>
      <a
        href="https://github.com/untded/references"
        class="rounded-md border border-line bg-paper p-5 transition-colors hover:border-un/60"
      >
        <h2 class="font-semibold text-ink">Source publication ↗</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          <span class="font-mono text-xs">untded/references</span> — the
          2005 edition PDF and related reference documents.
        </p>
      </a>
    </div>

    <section class="mt-10 rounded-md border border-line bg-mist p-6 text-sm leading-relaxed text-body">
      <h2 class="font-semibold text-ink">Attribution</h2>
      <p class="mt-2">
        Content: UNTDED 2005, ECE/TRADE/362 (in parallel ISO 7372:2005),
        © United Nations / UNECE. Digitized by this project on behalf of
        UN/CEFACT and ISO/TC 154; reproduced with attribution. Code: MIT.
        When you use the dataset, cite the source publication and this
        dataset.
      </p>
    </section>
  </div>
</BaseLayout>