---
import BaseLayout from '../layouts/BaseLayout.astro'
import UnlkExplorer from '../components/UnlkExplorer.astro'
import { loadElements } from '../lib/data'
import { href } from '../lib/site'
import { unlkRects, unlkZones, type UnlkRect } from '../lib/unlk'

// One field per distinct zone; many elements share a field — that is
// the point of the master document.
const elements = loadElements()
const fieldsMap = new Map<
  string,
  { key: string; rect: UnlkRect; elements: Array<{ tag: number; name: string | null; href: string }> }
>()
let elementsWithUnlk = 0
for (const e of elements) {
  const zones = unlkZones(e.bridges)
  if (!zones.length) continue
  elementsWithUnlk += 1
  const rects = unlkRects(e.bridges)
  for (const z of zones) {
    const rect = rects.find(
      (r) => r.lineFrom === z.lineFrom && r.lineTo === z.lineTo && r.posFrom === z.posFrom && r.posTo === z.posTo,
    )
    if (!rect) continue
    const key = [z.lineFrom, z.lineTo, z.posFrom, z.posTo].join(':')
    const field = fieldsMap.get(key) ?? { key, rect, elements: [] }
    field.elements.push({ tag: e.tag, name: e.name, href: href(`elements/${e.tag}`) })
    fieldsMap.set(key, field)
  }
}
const fields = [...fieldsMap.values()].sort((a, b) => a.rect.y - b.rect.y || a.rect.x - b.rect.x)
---

<BaseLayout
  title="The UN layout key — UN/TDED"
  description="The UN layout key (ISO 6422) reconstructed from the directory: every UNLK bridge plotted as a field on the standard A4 form. Pan, zoom, and select fields."
>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-un-deep">Parallel realization</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">The UN layout key</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-body">
      The United Nations Layout Key (UNLK, ISO 6422) is the standard A4 form for aligned
      trade documents: an image area of 183 × 280 mm on the layout-chart grid agreed with
      ISO 3535 — eight standard boxes across, 33 lines down. The directory’s bridges
      locate {elementsWithUnlk} elements on that grid by line and character position
      (L, P). Plotting them reconstructs the model form: the same data the directory
      carries, realized as the printed document.
    </p>

    <div class="mt-8">
      <UnlkExplorer fields={fields} />
    </div>

    <div class="mt-6 grid max-w-3xl gap-4 sm:grid-cols-2">
      <div class="rounded-md border border-line bg-mist p-4 text-sm text-body">
        <p class="font-semibold text-ink">{fields.length} distinct fields</p>
        <p class="mt-1">{elementsWithUnlk} elements carry a UNLK bridge; shared fields
        are the master-document principle at work — one box on the form serves every
        document derived from it.</p>
      </div>
      <div class="rounded-md border border-line bg-mist p-4 text-sm text-body">
        <p class="font-semibold text-ink">How to read a location</p>
        <p class="mt-1">L is the line on the form (1–33), P the character position
        within the line (1–82). A field spans both, e.g. an..17 at L 04, P 63–80:
        seventeen characters in eighteen positions on line 4 of the right-hand
        column.</p>
      </div>
    </div>
    <p class="mt-6 max-w-2xl text-sm text-body">
      Select a field to see the elements it carries. Sources: UNECE
      Recommendation No. 1 (ECE/TRADE/432E), ISO 6422, ISO 3535 — the{' '}
      <a class="text-un-deep underline decoration-un/50" href={href('/document')}>document pages</a>{' '}
      transcribe the directory’s own presentation rules.
    </p>
  </div>
</BaseLayout>
