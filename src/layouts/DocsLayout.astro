---
import BaseLayout from '../layouts/BaseLayout.astro'

interface Props {
  frontmatter: { title: string; description: string; eyebrow?: string }
}
const { frontmatter } = Astro.props
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-un-deep">{frontmatter.eyebrow ?? 'Documentation'}</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">{frontmatter.title.replace(/ — UN\/TDED.*$/, '')}</h1>
    <div class="prose-doc mt-6">
      <slot />
    </div>
  </div>
</BaseLayout>
