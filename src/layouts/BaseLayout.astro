---
import '@fontsource-variable/source-sans-3'
import '@fontsource-variable/source-serif-4'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/ibm-plex-mono/600.css'
import '../styles/main.css'
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { href } from '../lib/site'

interface Alternate {
  type: string
  href: string
}

interface Props {
  title: string
  description: string
  alternates?: Alternate[]
}

const { title, description, alternates = [] } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // no-flash theme bootstrap: persisted choice, else system preference.
      // Re-applied after every view-transition swap: ClientRouter replaces
      // the document element, dropping the class this script set on load.
      const applyTheme = () => {
        const t = localStorage.getItem('untded-theme')
        const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
      }
      applyTheme()
      document.addEventListener('astro:after-swap', applyTheme)
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="alternate icon" type="image/png" href={href('/favicon-32.png')} sizes="32x32" />
    <link rel="alternate icon" type="image/png" href={href('/favicon-16.png')} sizes="16x16" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    {alternates.map((alt) => <link rel="alternate" type={alt.type} href={alt.href} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={new URL(href('/og.png'), Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <script is:inline>
      // Delegated clipboard copy for .copy-btn (tag / IRI): registered
      // once on first load; document-level delegation survives every
      // view-transition swap without re-running.
      if (!window.__copyWired) {
        window.__copyWired = true
        document.addEventListener('click', async (event) => {
          const btn = event.target instanceof Element && event.target.closest('.copy-btn')
          if (!btn) return
          const value = btn.dataset.copy ?? ''
          try {
            await navigator.clipboard.writeText(value)
          } catch {
            window.prompt('Copy:', value)
          }
          const original = btn.textContent
          btn.textContent = 'Copied ' + value
          setTimeout(() => { btn.textContent = original }, 1200)
        })
      }
    </script>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
