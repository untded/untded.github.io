---
import type { Provenance } from '../lib/data'
import { href } from '../lib/site'

interface Props {
  provenance: Provenance
}
const { provenance } = Astro.props
---

<aside class="rounded-md border border-line bg-paper p-4 text-sm" aria-label="Source">
  <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider text-body">Source</h2>
  <dl class="space-y-1.5 text-body">
    <div class="flex justify-between gap-3">
      <dt>Source</dt>
      <dd class="text-right font-mono text-xs text-ink">{provenance.pdf}</dd>
    </div>
    <div class="flex justify-between gap-3">
      <dt>PDF page</dt>
      <dd class="font-mono tabular-nums text-ink">{provenance.page}</dd>
    </div>
    <div class="flex justify-between gap-3">
      <dt>Transcription confidence</dt>
      <dd>
        <span class="font-mono text-xs text-ink">{provenance.confidence}</span>
      </dd>
    </div>
  </dl>

</aside>