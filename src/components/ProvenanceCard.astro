---
import type { Provenance } from '../lib/data'
import { href } from '../lib/site'

interface Props {
  provenance: Provenance
}
const { provenance } = Astro.props
---

<aside class="rounded-md border border-line bg-paper p-4 text-sm" aria-label="Source">
  <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider text-body">Source</h2>
  <a
    class="font-mono text-xs text-un-deep underline decoration-un/50 hover:text-un-deep"
    href={href(`/pdf/UNTDED2005.pdf#page=${provenance.page}`)}
  >
    ECE/TRADE/362, page {provenance.page} ↗
  </a>
</aside>
