---
import type { Representation } from '../lib/data'

interface Props {
  repr: Representation | null
  size?: 'sm' | 'lg'
}
const { repr, size = 'sm' } = Astro.props
const text = repr?.raw ?? '—'
const variable = repr ? repr.min_length !== repr.max_length : false
const title = repr
  ? `${repr.charset}${variable ? '..' : ''} — ${repr.min_length} to ${repr.max_length} characters`
  : 'No representation printed in the source'
---

<span
  class:list={[
    'inline-block rounded-full border border-un/40 bg-un/5 font-mono text-un-ink',
    size === 'lg' ? 'px-3 py-1 text-base' : 'px-2 py-0.5 text-[0.8rem]',
  ]}
  title={title}
>
  {text}
</span>
