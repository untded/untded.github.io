---
// Character-position ruler of one UNLK line: positions 1–82 with a
// tick every ten, the element's span lit, and the printed format drawn
// at its true width — the field size and the representation meet.
import { UNLK, posToMm } from '../lib/unlk'

interface Props {
  from: number
  to: number
  format?: string
}
const { from, to, format } = Astro.props
const W = 240
const H = 34
const scale = W / UNLK.imageW
const x = (p: number) => (posToMm(p) - UNLK.marginX) * scale
const ticks = [1, 10, 20, 30, 40, 50, 60, 70, 80]
---

<svg viewBox={`0 0 ${W} ${H}`} class="block w-full max-w-[20rem]" role="img" aria-label={`Character positions ${from} to ${to}`}>
  <rect x="0" y="14" width={W} height="10" rx="2" class="fill-mist stroke-line" stroke-width="1" />
  {ticks.map((t) => (
    <g>
      <line x1={x(t)} y1="14" x2={x(t)} y2="24" class="stroke-body/50" stroke-width="1" />
      <text x={x(t)} y="10" text-anchor="middle" class="fill-body" font-size="8">{t}</text>
    </g>
  ))}
  <rect x={x(from)} y="12" width={Math.max(3, x(to + 1) - x(from))} height="14" rx="2" class="fill-un/60" />
  {format && <text x={x(from) + 2} y={H - 1} class="fill-un-ink font-mono" font-size="8">{format}</text>}
  <text x={x(from)} y="22" text-anchor={from > 60 ? 'end' : 'start'} class="fill-white" font-size="7.5" font-weight="600">{from === to ? from : `${from}–${to}`}</text>
</svg>
