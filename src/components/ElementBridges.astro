---
// The element page's bridges section: the bridge list, scheme links,
// EDED/UNCL chips, and machine-format links.
import BridgeList from './BridgeList.astro'
import type { ElementRecord } from '../lib/data'
import type { EdifactLink } from '../lib/edifact'
import { href } from '../lib/site'

interface Props {
  element: ElementRecord
  schemes: string[]
  edifact?: EdifactLink
  uncl?: number
}
const { element, schemes, edifact, uncl } = Astro.props
---

<section class="mt-8" aria-label="Bridges">
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-body">
    Locations &amp; bridges
  </h2>
  <BridgeList bridges={element.bridges} />
  {schemes.length > 0 && (
    <p class="mt-3 text-xs text-body/80">
      All elements on{' '}
      {schemes.map((sc, i) => (
        <>
          {i > 0 && <span>{' · '}</span>}
          <a class="text-un-deep underline decoration-un/50" href={href('/bridges#' + sc.replace(/[^A-Za-z0-9]/g, ''))}>{sc}</a>
        </>
      ))}{' '}
      — see the{' '}
      <a class="text-un-deep underline decoration-un/50" href={href('/notation/#bridges')}>bridge glossary</a>.
    </p>
  )}
  {(edifact || uncl !== undefined) && (
    <p class="mt-3 flex flex-wrap items-center gap-2">
      {edifact && (
        <a
          class:list={[
            'inline-flex items-baseline gap-2 rounded-full border px-3 py-1 text-xs',
            edifact.aligned ? 'border-line bg-mist text-body' : 'border-stamp/50 bg-stamp/5 text-stamp',
          ]}
          href={href(edifact.aligned ? '/docs/alignment-edifact' : '/docs/alignment-edifact#diff-' + edifact.tag)}
        >
          <span class="font-mono font-semibold">EDED {edifact.tag}</span>
          <span class="font-mono">{edifact.edifact.type}..{edifact.edifact.maxLength}</span>
          <span>{edifact.aligned ? 'aligned' : 'representation differs'}</span>
        </a>
      )}
      {uncl !== undefined && (
        <a
          class="inline-flex items-baseline gap-2 rounded-full border border-line bg-mist px-3 py-1 text-xs text-body"
          title="Code-qualified in the UN/EDIFACT D.05B UNCL (Volume II of the publication is the code-list volume)"
          href={href('/docs/alignment-edifact#code-lists-uncl')}
        >
          <span class="font-mono font-semibold">UNCL D05B</span>
          <span>{uncl === 1 ? '1 code value' : `${uncl} code values`}</span>
        </a>
      )}
    </p>
  )}
  <p class="mt-3 text-xs text-body/80">
    Machine formats:{' '}
    <a class="text-un-deep underline decoration-un/50" href={href(`/elements/${element.tag}/data.ttl`)}>Turtle</a>
    {' · '}
    <a class="text-un-deep underline decoration-un/50" href={href(`/elements/${element.tag}/data.jsonld`)}>JSON-LD</a>.
  </p>
</section>
