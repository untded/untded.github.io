---
// The UN layout key drawn to scale (A4, millimetre geometry from
// src/lib/unlk.ts) — the compact locator for element pages, with the
// element's zones highlighted. The full interactive reconstruction
// lives in UnlkExplorer on /unlk.
import { UNLK, type UnlkRect } from '../lib/unlk'

interface Props {
  zones: UnlkRect[]
}
const { zones = [] } = Astro.props

const gridV = Array.from({ length: UNLK.boxesAcross + 1 }, (_, i) => UNLK.marginX + i * UNLK.boxW)
const gridH = Array.from({ length: UNLK.lines + 1 }, (_, i) => UNLK.marginY + i * UNLK.linePitch * 2).filter(
  (y) => y <= UNLK.marginY + UNLK.imageH,
)
---

<svg
  viewBox={`0 0 ${UNLK.pageW} ${UNLK.pageH}`}
  class="block w-full max-w-[15rem] rounded-md"
  role="img"
  aria-label="Element location on the UN layout key"
>
  <rect x="0" y="0" width={UNLK.pageW} height={UNLK.pageH} class="fill-white dark:fill-[#101a26]" />
  <rect x={UNLK.marginX} y={UNLK.marginY} width={UNLK.imageW} height={UNLK.imageH} class="fill-un/[0.04] stroke-line" stroke-width="0.6" />

  {gridV.map((x) => <line x1={x} y1={UNLK.marginY} x2={x} y2={UNLK.marginY + UNLK.imageH} class="stroke-line" stroke-width="0.3" />)}
  {gridH.map((y) => <line x1={UNLK.marginX} y1={y} x2={UNLK.marginX + UNLK.imageW} y2={y} class="stroke-line" stroke-width="0.3" />)}

  {zones.map((z) => (
    <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="0.8" class="fill-un/60 stroke-un" stroke-width="0.8" />
  ))}

  <text x={UNLK.marginX} y={UNLK.pageH - 3.5} class="fill-body" font-size="2.9">
    UN layout key · ISO 6422 / ISO 3535 grid · lines 1–{UNLK.lines}
  </text>
</svg>
