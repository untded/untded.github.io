---
import Omnibox from '../islands/Omnibox.vue'
import { href } from '../lib/site'

const groups = [
  {
    label: 'Data',
    items: [
      { href: '/elements', label: 'Directory' },
      { href: '/tree', label: 'Tree' },
      { href: '/changes', label: 'Changes' },
    ],
  },
  {
    label: 'Semantics',
    items: [
      { href: '/ontology', label: 'Ontology' },
      { href: '/unlk', label: 'UNLK' },
      { href: '/notation', label: 'Notation' },
      { href: '/bridges', label: 'Bridges' },
    ],
  },
  {
    label: 'Source',
    items: [
      { href: '/publication', label: 'Publication' },
      { href: '/1993', label: '1993 edition' },
      { href: '/standards', label: 'Standards' },
    ],
  },
  {
    label: 'Project',
    items: [
      { href: '/guides', label: 'Guides' },
      { href: '/download', label: 'Download' },
      { href: '/about', label: 'About' },
    ],
  },
]
const current = Astro.url.pathname
const isCurrent = (path: string) => current.startsWith(path)
const isGroupCurrent = (items: { href: string }[]) => items.some((item) => isCurrent(item.href))
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl items-center gap-x-4 px-4 py-3">
    <a href={href('/')} class="flex shrink-0 items-center gap-2.5" aria-label="UN/TDED home">
      <img src={href('/img/un-logo-light.svg')} alt="United Nations emblem" class="h-7 w-7 dark:hidden" width="28" height="28" />
      <img src={href('/img/un-logo-dark.svg')} alt="" aria-hidden="true" class="hidden h-7 w-7 dark:block" width="28" height="28" />
      <span class="font-mono text-xl font-semibold tracking-tight text-ink">UN<span class="name-slash">/</span>TDED</span>
    </a>

    <!-- full nav: lg and up; each group is a native disclosure that opens on hover -->
    <nav aria-label="Site" class="hidden items-center gap-x-1 text-[0.95rem] lg:flex">
      {
        groups.map((group) => (
          <details class="nav-group group relative" data-nav-group>
            <summary
              class:list={[
                'flex cursor-pointer list-none items-center gap-1 rounded px-2 py-1.5 hover:text-un-deep [&::-webkit-details-marker]:hidden',
                isGroupCurrent(group.items) ? 'font-medium text-un-deep' : 'text-body',
              ]}
            >
              {group.label}
              <svg class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <ul class="absolute start-0 top-full z-40 mt-1 min-w-44 rounded-md border border-line bg-paper p-1 shadow-lg">
              {group.items.map((item) => (
                <li>
                  <a
                    href={href(item.href)}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded px-3 py-2 hover:bg-mist hover:text-un-deep',
                      isCurrent(item.href) ? 'font-medium text-un-deep' : 'text-body',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>

    <div class="ms-auto flex items-center gap-2">
      <Omnibox client:idle />
      <button
        type="button"
        id="theme-toggle"
        class="rounded-full border border-line bg-paper p-2.5 text-body hover:border-un/60 hover:text-un-deep transition-colors"
        aria-label="Switch light or dark theme"
        aria-pressed="false"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <!-- hamburger: below lg -->
      <button
        type="button"
        id="nav-toggle"
        class="rounded-full border border-line bg-paper p-2.5 text-body hover:border-un/60 hover:text-un-deep transition-colors lg:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="site-nav-mobile"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- mobile nav panel: below lg, toggled by the hamburger -->
  <nav
    id="site-nav-mobile"
    aria-label="Site"
    class="hidden border-t border-line bg-paper px-4 py-3 lg:hidden"
  >
    <div class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
      {
        groups.map((group) => (
          <div>
            <p class="px-2 text-xs font-semibold uppercase tracking-wider text-body/80">{group.label}</p>
            <ul class="mt-1 space-y-0.5 text-[0.95rem]">
              {group.items.map((item) => (
                <li>
                  <a
                    href={href(item.href)}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded px-2 py-1.5 hover:bg-mist hover:text-un-deep',
                      isCurrent(item.href) ? 'font-medium text-un-deep' : 'text-body',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </nav>
</header>

<script data-astro-rerun>
  const navGroups = [...document.querySelectorAll('[data-nav-group]')]

  // Pointer users get hover disclosure; keyboard users get native
  // details/summary behaviour from the same element.
  if (window.matchMedia('(hover: hover)').matches) {
    for (const group of navGroups) {
      group.addEventListener('pointerenter', () => {
        for (const other of navGroups) if (other !== group) other.removeAttribute('open')
        group.setAttribute('open', '')
      })
      group.addEventListener('pointerleave', () => group.removeAttribute('open'))
    }
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return
    if (event.target.closest('[data-nav-group]')) return
    for (const group of navGroups) group.removeAttribute('open')
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      for (const group of navGroups) group.removeAttribute('open')
    }
  })

  const btn = document.getElementById('theme-toggle')
  const sync = () => btn?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')))
  sync()
  btn?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark')
    localStorage.setItem('untded-theme', dark ? 'dark' : 'light')
    sync()
  })

  const navToggle = document.getElementById('nav-toggle')
  const navMobile = document.getElementById('site-nav-mobile')
  navToggle?.addEventListener('click', () => {
    const open = navMobile?.classList.toggle('hidden') === false
    navToggle.setAttribute('aria-expanded', String(open))
    navToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu')
  })
</script>
