---
import Omnibox from '../islands/Omnibox.vue'
import { href } from '../lib/site'

const nav = [
  { href: '/elements', label: 'Directory' },
  { href: '/tree', label: 'Tree' },
  { href: '/notation', label: 'Notation' },
  { href: '/ontology', label: 'Ontology' },
  { href: '/unlk', label: 'UNLK' },
  { href: '/document', label: 'Document' },
  { href: '/docs', label: 'Docs' },
  { href: '/download', label: 'Download' },
  { href: '/about', label: 'About' },
]
const current = Astro.url.pathname
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <a href={href('/')} class="flex items-center gap-2.5" aria-label="UN/TDED home">
      <img src={href('/img/un-logo-light.svg')} alt="United Nations emblem" class="h-7 w-7 dark:hidden" width="28" height="28" />
      <img src={href('/img/un-logo-dark.svg')} alt="" aria-hidden="true" class="hidden h-7 w-7 dark:block" width="28" height="28" />
      <span class="font-mono text-xl font-semibold tracking-tight text-ink">UN<span class="name-slash">/</span>TDED</span>
    </a>
    <nav aria-label="Site" class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.95rem]">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={current.startsWith(item.href) && item.href !== '/' ? 'page' : undefined}
            class:list={[
              'hover:text-un-deep',
              current.startsWith(item.href) && item.href !== '/' ? 'text-un-deep font-medium' : 'text-body',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ms-auto flex items-center gap-2">
      <Omnibox client:idle />
      <button
        type="button"
        id="theme-toggle"
        class="rounded-full border border-line bg-paper p-2 text-body hover:border-un/60 hover:text-un-deep transition-colors"
        aria-label="Switch light or dark theme"
        aria-pressed="false"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script data-astro-rerun>
  const btn = document.getElementById('theme-toggle')
  const sync = () => btn?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')))
  sync()
  btn?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark')
    localStorage.setItem('untded-theme', dark ? 'dark' : 'light')
    sync()
  })
</script>
