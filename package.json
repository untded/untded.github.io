{
  "name": "untded-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "build-data": "node scripts/build-data.mjs",
    "dev": "node scripts/build-data.mjs && astro dev",
    "build": "node scripts/build-data.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "links": "lychee --config lychee.toml --root-dir \"$(pwd)/dist\" 'dist/**/*.html'"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vue": "^7.0.1",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
